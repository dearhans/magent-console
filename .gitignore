# Python
__pycache__/
*.pyc
*.pyo
venv/
.venv/

# 修复 server.py 时留下的本地快照，不入库
server_*.py

# 运行时产物
temp/
*.log

# 系统
.DS_Store
Thumbs.db

# 凭据配置（含 API Key）—— 存于 ~/.magent-console/config.json，
# 该文件不在仓库内，此处仅为防止误复制进项目目录而设的多道防线。
# 支持 MAGENT_CONFIG 环境变量覆盖路径，若你把配置重定向到项目内，
# 这条规则能确保它永远不会进 git。
config.json
.magent-console/
*.key
.env
